<UserControl
    x:Class="DynamoCopilot.Extension.Views.AuthFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DynamoCopilot.Extension.Converters">

    <UserControl.Resources>

        <!-- Colours -->
        <SolidColorBrush x:Key="AuthAccentBrush" Color="#6EC6F5"/>
        <SolidColorBrush x:Key="AuthTextBrush"   Color="#D4D4D4"/>
        <SolidColorBrush x:Key="AuthMutedBrush"  Color="#8B8B8B"/>
        <SolidColorBrush x:Key="AuthErrorBrush"  Color="#F48771"/>

        <!-- Converters -->
        <BooleanToVisibilityConverter          x:Key="AuthBoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="AuthInvBoolToVis"/>

        <!-- Primary action button -->
        <Style x:Key="AuthPrimaryBtn" TargetType="Button">
            <Setter Property="Background"   Value="#6EC6F5"/>
            <Setter Property="Foreground"   Value="#000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9CD5F9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Setter Property="Foreground" Value="#6B6B6B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark text input -->
        <Style x:Key="AuthDarkInput" TargetType="TextBox">
            <Setter Property="Background"       Value="#2D2D2D"/>
            <Setter Property="Foreground"       Value="#D4D4D4"/>
            <Setter Property="BorderBrush"      Value="#3A3A3A"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="8,6"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="CaretBrush"       Value="#6EC6F5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6EC6F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark password input -->
        <Style x:Key="AuthDarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background"       Value="#2D2D2D"/>
            <Setter Property="Foreground"       Value="#D4D4D4"/>
            <Setter Property="BorderBrush"      Value="#3A3A3A"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="8,6"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="CaretBrush"       Value="#6EC6F5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6EC6F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <StackPanel Margin="28,32,28,28">

        <!-- Logo + title -->
        <Path Data="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z"
              Fill="#6EC6F5" Width="36" Height="36" Stretch="Uniform"
              HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.9"/>
        <TextBlock Text="BIMEra"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource AuthTextBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
        <TextBlock FontSize="12" Foreground="{StaticResource AuthMutedBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,28">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Sign in to continue"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                            <Setter Property="Text" Value="Create your account"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- ── LOGIN FORM ── -->
        <StackPanel Visibility="{Binding IsLoginMode, Converter={StaticResource AuthBoolToVis}}">
            <TextBlock Text="Email" FontSize="11" Foreground="{StaticResource AuthMutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="LoginEmailBox"
                     Style="{StaticResource AuthDarkInput}"
                     Text="{Binding LoginEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Password" FontSize="11" Foreground="{StaticResource AuthMutedBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="LoginPasswordBox"
                         Style="{StaticResource AuthDarkPasswordBox}"
                         Margin="0,0,0,20"/>

            <Button Content="Sign In"
                    Style="{StaticResource AuthPrimaryBtn}"
                    Padding="0,10" FontSize="13"
                    IsEnabled="{Binding IsAuthIdle}"
                    Click="OnLoginClick"
                    Margin="0,0,0,16"/>

            <TextBlock Text="Signing in…"
                       FontSize="12" Foreground="{StaticResource AuthMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"
                       Visibility="{Binding IsAuthBusy, Converter={StaticResource AuthBoolToVis}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Don't have an account? "
                           FontSize="12" Foreground="{StaticResource AuthMutedBrush}"/>
                <TextBlock FontSize="12" Foreground="{StaticResource AuthAccentBrush}"
                           Cursor="Hand" MouseLeftButtonUp="OnSwitchToRegister">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Create account"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- ── REGISTER FORM ── -->
        <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource AuthBoolToVis}}">
            <TextBlock Text="Email" FontSize="11" Foreground="{StaticResource AuthMutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="RegisterEmailBox"
                     Style="{StaticResource AuthDarkInput}"
                     Text="{Binding RegisterEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Password" FontSize="11" Foreground="{StaticResource AuthMutedBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="RegisterPasswordBox"
                         Style="{StaticResource AuthDarkPasswordBox}"
                         Margin="0,0,0,12"/>

            <TextBlock Text="Confirm Password" FontSize="11" Foreground="{StaticResource AuthMutedBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="RegisterConfirmPasswordBox"
                         Style="{StaticResource AuthDarkPasswordBox}"
                         Margin="0,0,0,20"/>

            <Button Content="Create Account"
                    Style="{StaticResource AuthPrimaryBtn}"
                    Padding="0,10" FontSize="13"
                    IsEnabled="{Binding IsAuthIdle}"
                    Click="OnRegisterClick"
                    Margin="0,0,0,16"/>

            <TextBlock Text="Creating account…"
                       FontSize="12" Foreground="{StaticResource AuthMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"
                       Visibility="{Binding IsAuthBusy, Converter={StaticResource AuthBoolToVis}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Already have an account? "
                           FontSize="12" Foreground="{StaticResource AuthMutedBrush}"/>
                <TextBlock FontSize="12" Foreground="{StaticResource AuthAccentBrush}"
                           Cursor="Hand" MouseLeftButtonUp="OnSwitchToLogin">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Sign in"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Error message (shared) -->
        <Border Background="#3D1515" BorderBrush="#F48771" BorderThickness="1"
                CornerRadius="5" Padding="10,8" Margin="0,16,0,0"
                Visibility="{Binding HasAuthError, Converter={StaticResource AuthBoolToVis}}">
            <TextBlock Text="{Binding AuthError}"
                       Foreground="{StaticResource AuthErrorBrush}"
                       FontSize="12" TextWrapping="Wrap"/>
        </Border>

    </StackPanel>
</UserControl>
