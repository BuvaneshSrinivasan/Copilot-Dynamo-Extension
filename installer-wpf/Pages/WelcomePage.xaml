<UserControl x:Class="DynamoCopilot.Installer.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- Left accent stripe -->
        <Border Width="4" HorizontalAlignment="Left">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4F8EF7" Offset="0"/>
                    <GradientStop Color="#6366F1" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main content – centred column -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,-20,0,0">

            <!-- ── BIMEra logo ── -->
            <Image Source="pack://application:,,,/Resources/logo.png"
                   Width="90" Height="90"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,22"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- ── App name ── -->
            <TextBlock Text="Dynamo Copilot"
                       Foreground="#E2E8F8"
                       FontFamily="Segoe UI Light"
                       FontSize="32"
                       FontWeight="Light"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#4F8EF7" BlurRadius="22"
                                      ShadowDepth="0" Opacity="0.18"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- ── Tagline ── -->
            <TextBlock Text="Your Vibe Coding Partner"
                       Foreground="#8090BE"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,36"/>

            <!-- ── Install button ── -->
            <Button x:Name="InstallBtn"
                    Content="Install Now"
                    Style="{StaticResource PrimaryBtn}"
                    HorizontalAlignment="Center"
                    Click="InstallBtn_Click"/>

            <!-- ── Version / publisher ── -->
            <TextBlock x:Name="VersionText"
                       Text="v1.0.0 · BIMEra"
                       Foreground="#6B7BAA"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
