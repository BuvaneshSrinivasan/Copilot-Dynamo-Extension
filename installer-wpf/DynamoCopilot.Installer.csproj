<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DynamoCopilot.Installer</RootNamespace>
    <AssemblyName>DynamoCopilot-Setup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon />
    <!-- Change Company here to update the publisher shown in the installer UI -->
    <Company>BimEra</Company>
    <Product>DynamoCopilot</Product>
    <!-- Version is injected at publish time via -p:Version= (build-installer.ps1). -->
    <FileVersion>$(Version)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\DynamoCopilot.Core\DynamoCopilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Bootstrapper\**" />
    <EmbeddedResource Remove="Bootstrapper\**" />
    <None Remove="Bootstrapper\**" />
    <Compile Remove="DynamoCopilot.Updater\**" />
    <EmbeddedResource Remove="DynamoCopilot.Updater\**" />
    <None Remove="DynamoCopilot.Updater\**" />
  </ItemGroup>

</Project>
